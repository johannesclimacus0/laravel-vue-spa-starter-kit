#!/usr/bin/env bash
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

echo "checking working tree:"

if [[ -n "$(git status --porcelain)" ]]; then
    echo "push blocked: commit or discard changes first"
    git status --short
    exit 1
fi

echo "fixing php formatting:"
composer lint

echo "fixing frontend formatting:"
npm run check:fix

echo "checking formatting changes:"

if [[ -n "$(git status --porcelain)" ]]; then
    echo ""
    echo "review and commit the changes, then push again"
    git status --short
    exit 1
fi

echo "validating composer:"
composer validate --strict

echo "building frontend:"
npm run build

echo "running project checks:"
composer ci:check

echo "auditing dependencies:"
composer audit --locked
npm audit --omit=dev

echo "checking final working tree:"

if [[ -n "$(git status --porcelain)" ]]; then
    echo "checks generated uncommitted changes"
    git status --short
    exit 1
fi

echo ""
echo "checks passed"
